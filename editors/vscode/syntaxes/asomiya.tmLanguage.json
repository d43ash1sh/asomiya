{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Asomiya",
  "scopeName": "source.asomiya",
  "fileTypes": [
    "asom"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#function-declaration"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.asomiya",
          "match": "//.*$"
        },
        {
          "name": "comment.block.asomiya",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.asomiya",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.asomiya",
          "match": "\\\\."
        }
      ]
    },
    "function-declaration": {
      "match": "((?<![\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}])(?:phangchon|fangchon|fanchon|ফাংচন)(?![\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]))\\s+([\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*)",
      "captures": {
        "1": {
          "name": "storage.type.function.asomiya"
        },
        "2": {
          "name": "entity.name.function.asomiya"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.type.asomiya",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}])(?:phangchon|fangchon|fanchon|dhara|dhora|ফাংচন|ধৰা)(?![\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}])"
        },
        {
          "name": "keyword.control.asomiya",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}])(?:ঘূৰাই|ghurai)[ \\t]+(?:দিয়া|দিয়া|diya|dia)(?![\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}])"
        },
        {
          "name": "keyword.control.asomiya",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}])(?:jetiyaloike|zetiyaloike|যেতিয়ালৈকে|ghuraidiya|jetialoike|zetialoike|ঘূৰাইদিয়া|যেতিয়ালৈকে|ghuraidia|jetialoke|ঘূৰাইদিয়া|aagbaara|প্ৰতিটো|aagbara|agbarha|agobara|pratito|protito|protitu|আগবাঢ়া|প্ৰতিটো|agbara|maajot|majhot|nahale|nahole|noh'le|noh’le|nohole|আগবাঢ়া|majat|majot|nhole|nohle|rakha|rokha|নহ'লে|নহ’লে|jadi|jodi|zodi|নহলে|মাজত|যদি|ৰখা)(?![\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}])"
        },
        {
          "name": "constant.language.asomiya",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}])(?:khaali|khali|micha|misha|sacha|socha|xocha|hosa|misa|sosa|xosa|খালী|মিছা|সঁচা)(?![\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}])"
        },
        {
          "name": "keyword.operator.logical.asomiya",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}])(?:nahoy|nohoi|nohoy|aaru|নহয়|aru|baa|আৰু|নহয়|ba|বা)(?![\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}])"
        },
        {
          "name": "support.function.builtin.asomiya",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}])(?:dairghya|doirghyo|purnanka|purnanko|sanjojan|sonjojon|xongkhya|xonjojon|পূৰ্ণাংক|doirgho|purnank|sankhya|sonkhya|xonkhya|দৈৰ্ঘ্য|সংযোজন|prakar|prokar|প্ৰকাৰ|সংখ্যা|সংযোজন|paath|sodha|sudha|xodha|xudha|কোৱা|সোধা|kowa|kuwa|path|কোৱা|সোধা|koa|kua|পাঠ)(?![\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}])"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.asomiya",
      "match": "(?<![\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}])[0-9০-৯]+(?:\\.[0-9০-৯]+)?(?![\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}])"
    },
    "calls": {
      "match": "([\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.asomiya"
        }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.asomiya",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.asomiya",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.asomiya",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.asomiya",
          "match": "[+\\-*/%]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.asomiya",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.asomiya",
          "match": ";"
        }
      ]
    }
  }
}
