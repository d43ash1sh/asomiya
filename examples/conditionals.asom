// নহ'লে যদি — শৃংখলিত চৰ্ত
ফাংচন গ্ৰেড(নম্বৰ) {
    যদি (নম্বৰ >= ৯০) {
        ঘূৰাইদিয়া "ক"
    } নহ'লে যদি (নম্বৰ >= ৭৫) {
        ঘূৰাইদিয়া "খ"
    } নহ'লে যদি (নম্বৰ >= ৬০) {
        ঘূৰাইদিয়া "গ"
    } নহ'লে {
        ঘূৰাইদিয়া "ঘ"
    }
}

কোৱা("৯৫ →", গ্ৰেড(৯৫))
কোৱা("৮০ →", গ্ৰেড(৮০))
কোৱা("৬৫ →", গ্ৰেড(৬৫))
কোৱা("৪০ →", গ্ৰেড(৪০))

// আৰু / বা / !
ধৰা বৰষুণ = সঁচা
ধৰা ছাতি_আছে = মিছা
যদি (বৰষুণ আৰু !ছাতি_আছে) {
    কোৱা("তিতিব লাগিব!")
}
যদি (ছাতি_আছে বা !বৰষুণ) {
    কোৱা("শুকান থাকিম")
} নহ'লে {
    কোৱা("ঘৰতে থাকোঁ")
}

// নেষ্টেড চৰ্ত
ধৰা বছৰ = ২০২৪
যদি (বছৰ % ৪ == ০) {
    যদি (বছৰ % ১০০ != ০ || বছৰ % ৪০০ == ০) {
        কোৱা(বছৰ, "অধিবৰ্ষ")
    } নহ'লে {
        কোৱা(বছৰ, "অধিবৰ্ষ নহয়")
    }
}
