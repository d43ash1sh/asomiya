// ফাংচন ঘোষণা আৰু মতা
ফাংচন যোগ(ক, খ) {
    ঘূৰাইদিয়া ক + খ
}

ধৰা ফলাফল = যোগ(১০, ২০)
কোৱা(ফলাফল)

// ৰিকাৰ্চন: কাৰক (factorial)
ফাংচন কাৰক(ন) {
    যদি (ন <= ১) {
        ঘূৰাইদিয়া ১
    }
    ঘূৰাইদিয়া ন * কাৰক(ন - ১)
}
কোৱা("৫! =", কাৰক(৫))

// ফিবোনাচি
ফাংচন ফিবোনাচি(ন) {
    যদি (ন < ২) { ঘূৰাইদিয়া ন }
    ঘূৰাইদিয়া ফিবোনাচি(ন - ১) + ফিবোনাচি(ন - ২)
}
কোৱা("ফিবোনাচি(১৫) =", ফিবোনাচি(১৫))

// ফাংচনো এটা মান: ইয়াক আন ফাংচনলৈ পঠিয়াব পাৰি
ফাংচন দুবাৰ(কাম, মান) {
    ঘূৰাইদিয়া কাম(কাম(মান))
}
ফাংচন দুগুণ(x) { ঘূৰাইদিয়া x * ২ }
কোৱা(দুবাৰ(দুগুণ, ৫))

// ক্ল'জাৰ: গণক
ফাংচন গণক_বনোৱা() {
    ধৰা গণনা = ০
    ফাংচন বঢ়োৱা() {
        গণনা = গণনা + ১
        ঘূৰাইদিয়া গণনা
    }
    ঘূৰাইদিয়া বঢ়োৱা
}
ধৰা গণক = গণক_বনোৱা()
গণক()
গণক()
কোৱা("গণক:", গণক())
