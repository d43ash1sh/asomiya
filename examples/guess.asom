// সংখ্যা অনুমান কৰা খেল (সোধা ব্যৱহাৰ কৰি)
ধৰা গোপন = ৭
ধৰা চেষ্টা = ০

যেতিয়ালৈকে (সঁচা) {
    ধৰা উত্তৰ = সোধা("১ৰ পৰা ১০লৈ এটা সংখ্যা অনুমান কৰক: ")
    যদি (উত্তৰ == খালী) {
        কোৱা("খেল বন্ধ কৰা হ'ল।")
        ৰখা
    }
    ধৰা অনুমান = সংখ্যা(উত্তৰ)
    যদি (অনুমান == খালী) {
        কোৱা("অনুগ্ৰহ কৰি এটা সংখ্যা লিখক।")
        আগবাঢ়া
    }
    চেষ্টা = চেষ্টা + ১
    যদি (অনুমান < গোপন) {
        কোৱা("অলপ ডাঙৰ সংখ্যা কওক।")
    } নহ'লে যদি (অনুমান > গোপন) {
        কোৱা("অলপ সৰু সংখ্যা কওক।")
    } নহ'লে {
        কোৱা("শুদ্ধ! আপুনি", চেষ্টা, "বাৰত পালে।")
        ৰখা
    }
}
