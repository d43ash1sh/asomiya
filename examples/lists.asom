// তালিকা
ধৰা ফল = ["আম", "কল", "লিচু"]
কোৱা(ফল)
কোৱা("প্ৰথম ফল:", ফল[০])
কোৱা("ফলৰ সংখ্যা:", দৈৰ্ঘ্য(ফল))

সংযোজন(ফল, "কঁঠাল")
ফল[১] = "আনাৰস"
কোৱা(ফল)

// তালিকাৰ ওপৰেৰে লুপ
ধৰা সংখ্যাবোৰ = [৩, ৮, ১, ৯, ৪]
ধৰা সৰ্বোচ্চ = সংখ্যাবোৰ[০]
ধৰা i = ১
যেতিয়ালৈকে (i < দৈৰ্ঘ্য(সংখ্যাবোৰ)) {
    যদি (সংখ্যাবোৰ[i] > সৰ্বোচ্চ) {
        সৰ্বোচ্চ = সংখ্যাবোৰ[i]
    }
    i = i + ১
}
কোৱা("সৰ্বোচ্চ:", সৰ্বোচ্চ)

// পাঠৰ আখৰবোৰ (যুক্তাক্ষৰ ভাঙি নিদিয়াকৈ)
ধৰা শব্দ = "প্ৰাপ্তবয়স্ক"
ধৰা j = ০
ধৰা আখৰবোৰ = []
যেতিয়ালৈকে (j < দৈৰ্ঘ্য(শব্দ)) {
    সংযোজন(আখৰবোৰ, শব্দ[j])
    j = j + ১
}
কোৱা(আখৰবোৰ)
