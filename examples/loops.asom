// যেতিয়ালৈকে — চৰ্ত সঁচা হৈ থকালৈকে চলি থাকে
ধৰা ক = ১
ধৰা যোগফল = ০
যেতিয়ালৈকে (ক <= ১০) {
    যোগফল = যোগফল + ক
    ক = ক + ১
}
কোৱা("১ৰ পৰা ১০লৈ যোগফল:", যোগফল)

// ৰখা — লুপৰ পৰা ওলাই অহা
ধৰা ন = ১
যেতিয়ালৈকে (সঁচা) {
    যদি (ন * ন > ৫০) {
        ৰখা
    }
    ন = ন + ১
}
কোৱা("যিটো সংখ্যাৰ বৰ্গ ৫০তকৈ বেছি:", ন)

// নামতা
ধৰা শাৰী = ১
যেতিয়ালৈকে (শাৰী <= ৫) {
    কোৱা("৭ ×", শাৰী, "=", ৭ * শাৰী)
    শাৰী = শাৰী + ১
}

// প্ৰতিটো … মাজত — তালিকাৰ প্ৰতিটো উপাদানৰ বাবে
ধৰা ফলবোৰ = ["আম", "কল", "লিচু"]
প্ৰতিটো ফল ফলবোৰ মাজত {
    কোৱা("মোৰ " + ফল + " ভাল লাগে")
}

// নেষ্টেড লুপ: তৰাৰ ত্ৰিভুজ
ধৰা উচ্চতা = ১
যেতিয়ালৈকে (উচ্চতা <= ৪) {
    ধৰা ৰেখা = ""
    ধৰা গণনা = ০
    যেতিয়ালৈকে (গণনা < উচ্চতা) {
        ৰেখা = ৰেখা + "★"
        গণনা = গণনা + ১
    }
    কোৱা(ৰেখা)
    উচ্চতা = উচ্চতা + ১
}
