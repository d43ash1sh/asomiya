// চলক আৰু মানৰ প্ৰকাৰ
ধৰা নাম = "গুৱাহাটী"
ধৰা জনসংখ্যা = ১১২৮০০০
ধৰা ৰাজধানী = মিছা
ধৰা নদী                 // কোনো মান নিদিলে খালী

কোৱা(নাম, প্ৰকাৰ(নাম))
কোৱা(জনসংখ্যা, প্ৰকাৰ(জনসংখ্যা))
কোৱা(ৰাজধানী, প্ৰকাৰ(ৰাজধানী))
কোৱা(নদী, প্ৰকাৰ(নদী))

নদী = "ব্ৰহ্মপুত্ৰ"
কোৱা(নাম + "ৰ কাষেৰে বৈ যায় " + নদী)

// ইংৰাজী অংকও চলে; ছপা হয় অসমীয়া অংকত
ধৰা বছৰ = 2024
কোৱা("বছৰ:", বছৰ)

// এটা শাৰীত কেইবাটাও বাক্য — ";" বা "।" দি
ধৰা ক = ১; ধৰা খ = ২। কোৱা(ক + খ)

// পৰিসৰ (scope)
ধৰা স্তৰ = "বাহিৰ"
{
    ধৰা স্তৰ = "ভিতৰ"
    কোৱা(স্তৰ)
}
কোৱা(স্তৰ)
