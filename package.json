{
  "name": "asomiya",
  "version": "0.1.1",
  "description": "অসমীয়া — an educational programming language written in Assamese, with a TypeScript interpreter.",
  "keywords": [
    "assamese",
    "অসমীয়া",
    "programming-language",
    "interpreter",
    "toy-language",
    "education"
  ],
  "license": "MIT",
  "author": "Debashish Bordoloi",
  "contributors": [
    {
      "name": "Arnab Sharma",
      "url": "https://github.com/arnabsmh"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d43ash1sh/asomiya.git"
  },
  "homepage": "https://d43ash1sh.github.io/asomiya/",
  "bugs": {
    "url": "https://github.com/d43ash1sh/asomiya/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "asomiya": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "docs/LANGUAGE_SPEC.md",
    "docs/GRAMMAR.md",
    "docs/KEYWORDS.md",
    "docs/ERRORS.md",
    "docs/ARCHITECTURE.md",
    "README.md",
    "README.as.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p playground",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepublishOnly": "npm run check && npm run build",
    "docs:errors": "npm run build && node scripts/generate-error-docs.mjs && prettier --write docs/ERRORS.md",
    "playground:build": "tsup --config tsup.playground.config.ts",
    "playground:serve": "npm run playground:build && python3 -m http.server 8080 --directory site"
  },
  "dependencies": {
    "commander": "14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "eslint": "10.15.0",
    "globals": "16.5.0",
    "prettier": "3.10.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12"
  }
}
