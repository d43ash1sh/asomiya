{
  "name": "asomiya",
  "version": "0.3.2",
  "description": "অসমীয়া — a programming language in Assamese. Write code in Assamese script or in English letters (dhora, kowa, jodi). Interpreter, REPL and browser playground.",
  "keywords": [
    "assamese",
    "অসমীয়া",
    "asomiya",
    "programming-language",
    "assamese-programming-language",
    "romanized-assamese",
    "interpreter",
    "toy-language",
    "education",
    "learn-to-code",
    "repl",
    "cli",
    "typescript",
    "unicode",
    "indic"
  ],
  "license": "MIT",
  "author": {
    "name": "Debashish Bordoloi",
    "url": "https://github.com/d43ash1sh"
  },
  "contributors": [
    {
      "name": "Arnab Sharmah",
      "url": "https://github.com/arnabsmh"
    },
    {
      "name": "Siddhartha Borah",
      "url": "https://github.com/siddharthaborah"
    },
    {
      "name": "Bigratom Saikia",
      "url": "https://github.com/saikiabigratom-design"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d43ash1sh/asomiya.git"
  },
  "homepage": "https://asomiya.codes",
  "bugs": {
    "url": "https://github.com/d43ash1sh/asomiya/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "asomiya": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "docs/LANGUAGE_SPEC.md",
    "docs/GRAMMAR.md",
    "docs/KEYWORDS.md",
    "docs/ROMAN.md",
    "docs/ERRORS.md",
    "docs/ARCHITECTURE.md",
    "README.md",
    "README.as.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p website",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepublishOnly": "npm run check && npm run build",
    "docs:errors": "npm run build && node scripts/generate-error-docs.mjs && prettier --write docs/ERRORS.md",
    "website:build": "tsup --silent && tsup --config tsup.website.config.ts && node website/build.mjs",
    "website:serve": "npm run website:build && python3 -m http.server 8080 --directory website/dist",
    "vscode:grammar": "tsup editors/vscode/scripts/write-grammar.ts --format cjs --shims --out-dir editors/vscode/dist-tools --silent && node editors/vscode/dist-tools/write-grammar.cjs",
    "vscode:build": "tsup --config editors/vscode/tsup.config.ts",
    "vscode:package": "npm run vscode:build && cd editors/vscode && npx --yes @vscode/vsce@4.1.0 package --no-dependencies --out asomiya-vscode.vsix"
  },
  "dependencies": {
    "commander": "14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "@types/vscode": "1.90.0",
    "eslint": "10.15.0",
    "globals": "16.5.0",
    "prettier": "3.10.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
